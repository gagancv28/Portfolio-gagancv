# ─────────────────────────────────────────────────────────────
# GAGAN.C.V Portfolio — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Web3Forms — Get your free access key at https://web3forms.com
# Used by the contact form in the browser to submit messages.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=insert_your_web3forms_key_here

# SMTP Email — Used server-side by /api/contact (Nodemailer)
# Use a Gmail App Password (not your regular Gmail password).
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
